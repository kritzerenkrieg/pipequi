{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pipequi",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "pipequi.kuritzu.de", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
